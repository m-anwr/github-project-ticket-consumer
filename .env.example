# GitHub Configuration
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_PROJECT_NUMBER=1
# Comma-separated GitHub usernames whose comments count as human answers in "Needs input"
GITHUB_ALLOWED_AUTHORS=your-username
# Comma-separated bot logins for code review (default: kilo-code-bot[bot])
REVIEW_BOT_LOGINS=kilo-code-bot[bot]
# GitHub CheckRun name to wait for before evaluating review
REVIEW_CHECK_NAME=Kilo Code Review
# Also wait for all other CI checks (if any) to succeed before auto-merging
REQUIRE_ALL_CHECKS=true

# OpenCode Server Configuration
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER_ID=anthropic
OPENCODE_MODEL_ID=claude-sonnet-4-20250514
# Optional basic auth password if OPENCODE_SERVER_PASSWORD is set on your VPS
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode
# Inactivity timeout (ms) for the long-running OpenCode message POST.
# 0 = no timeout, and that is the right value: OpenCode holds the response
# open for the whole agent turn, so any client-side cap would abandon a run
# that is still working. (Node's fetch would abort it after 300s.)
OPENCODE_MESSAGE_TIMEOUT_MS=0

# Git & Workspace Configuration
# Path to a local clone of the target repository on your VPS
REPO_LOCAL_PATH=/var/lib/ticket-consumer/repo
BASE_BRANCH=main
DATA_DIR=./data

# Loop & Merge Behavior
POLL_INTERVAL_MS=15000
MAX_REVIEW_ITERATIONS=5
AUTO_MERGE_METHOD=squash
# Option A (keep_in_review): keep in "In review" with "ready to merge" label until manually merged, then move to Done
# Option B (move_to_done): move to "Done" immediately after review passes
MANUAL_MERGE_BEHAVIOR=keep_in_review
MANUAL_MERGE_LABEL=manual merge
READY_TO_MERGE_LABEL=ready to merge
# How review findings and human replies reach the agent:
#   agent  = the daemon passes the comment ids and the agent fetches the
#            comments itself with the `gh` CLI (needs gh on the AGENT's PATH)
#   inline = the daemon quotes the comment bodies and diff hunks into the prompt
# The daemon falls back to `inline` at startup if gh is missing or unauthenticated.
COMMENT_DELIVERY=agent
